@model ArmRipper.Core.Metadata.OmdbSearchResult
@{
    ViewData["Title"] = "Search Movies - ARM";
    var jobs = ViewBag.Jobs as IEnumerable<ArmRipper.Core.Models.Job>;
    var selectedJobId = ViewBag.SelectedJobId as int?;
    var exact = ViewBag.ExactMatch as bool? ?? false;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var selectedType = ViewBag.SelectedType as string;
    var query = Context.Request.Query["query"];
    bool Selected(int jobId) => selectedJobId.HasValue && selectedJobId.Value == jobId;
    var jobIdValue = selectedJobId.GetValueOrDefault();
    var importFilePath = ViewBag.ImportFilePath as string;
    var isImportMode = !string.IsNullOrEmpty(importFilePath);
    var apiError = ViewBag.ApiError as string;
    var searchResults = Model?.Search;
    var hasResults = searchResults is { Count: > 0 };
    var totalPages = Model?.TotalPages ?? 0;
    var totalResults = int.TryParse(Model?.TotalResults, out var t) ? t : 0;

    string PageUrl(int p)
    {
        var parts = new List<string> { $"query={Uri.EscapeDataString(query.ToString() ?? "")}" };
        if (selectedJobId.HasValue) parts.Add($"jobId={selectedJobId.Value}");
        if (exact) parts.Add("exact=true");
        if (!string.IsNullOrEmpty(selectedType)) parts.Add($"type={Uri.EscapeDataString(selectedType)}");
        parts.Add($"page={p}");
        return "/jobs/titlesearch?" + string.Join("&", parts);
    }
}

<h1>Search Movies</h1>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" action="/jobs/titlesearch" class="form-inline">
            <div class="form-group mr-2">
                <label class="mr-2 font-weight-bold" for="titleInput">Title</label>
                <input type="text" id="titleInput" name="query" class="form-control" value="@query" placeholder="Movie title..." required style="min-width:250px" />
            </div>
            <div class="form-group mr-2">
                <label class="mr-2 font-weight-bold" for="jobSelect">Job</label>
                <select name="jobId" id="jobSelect" class="form-control">
                    <option value="">— Select job —</option>
                    @if (jobs is not null)
                    {
                        foreach (var job in jobs)
                        {
                            <option value="@job.Id" selected="@(Selected(job.Id) ? "selected" : null)">
                                #@job.Id — @(job.Title ?? job.Label ?? "Untitled")
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="form-group mr-2">
                <label class="mr-2 font-weight-bold" for="typeSelect">Type</label>
                <select name="type" id="typeSelect" class="form-control">
                    <option value="">All</option>
                    <option value="movie" selected="@(selectedType == "movie" ? "selected" : null)">Movie</option>
                    <option value="series" selected="@(selectedType == "series" ? "selected" : null)">Series</option>
                    <option value="episode" selected="@(selectedType == "episode" ? "selected" : null)">Episode</option>
                </select>
            </div>
            <div class="form-group mr-2">
                <div class="form-check">
                    <input type="checkbox" id="exactCheck" name="exact" value="true" class="form-check-input" @(exact ? "checked" : "")
                           onchange="document.getElementById('exactHidden').disabled = this.checked;" />
                    <label class="form-check-label font-weight-bold" for="exactCheck">Exact match</label>
                    <input type="hidden" id="exactHidden" name="exact" value="false" @(exact ? "disabled" : "") />
                </div>
            </div>
            <input type="hidden" name="page" value="1" />
            <button type="submit" class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(query))
            {
                <a href="/jobs/titlesearch@(selectedJobId.HasValue ? "?jobId=" + selectedJobId.Value : "")" class="btn btn-outline-secondary ml-2">Clear</a>
            }
        </form>
    </div>
</div>

@if (isImportMode)
{
    <div class="alert alert-info">
        <strong>Import Mode:</strong> Select a movie below to create a new transcode job for
        <code>@System.IO.Path.GetFileName(importFilePath)</code>.
        The rip stage will be skipped — only transcoding will be performed.
        Select the correct <strong>Disc Type</strong> (Blu‑ray, DVD, or 4K&nbsp;UHD) to apply
        the appropriate encoding preset.
    </div>
}

@if (!string.IsNullOrEmpty(apiError))
{
    <div class="alert alert-danger">
        <strong>API Error:</strong> @apiError
    </div>
}

@if (string.IsNullOrEmpty(query))
{
    <div class="alert alert-info">Enter a movie title above to search online databases (OMDB/TMDB).</div>
}
else if (!hasResults && string.IsNullOrEmpty(apiError))
{
    <div class="alert alert-warning">No results found for &quot;@query&quot;. Try a different title or check your API keys in Settings.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Results for &quot;@query&quot; (@totalResults.ToString("N0") results, page @currentPage of @totalPages)</h5>
    </div>

    if (hasResults)
    {
        <div class="row">
            @foreach (var item in searchResults!)
            {
                var poster = !string.IsNullOrEmpty(item.Poster) && item.Poster != "N/A" ? item.Poster : "/img/none.png";
                var hasJob = jobIdValue > 0;

                <div class="col-md-3 col-sm-4 col-6 mb-4">
                    <div class="card text-center h-100">
                        <a href="@(hasJob ? "/jobs/select-title?imdbId=" + item.ImdbID + "&jobId=" + jobIdValue : "#")" title="View details">
                            <img src="@poster" class="card-img-top img-thumbnail" alt="@item.Title poster"
                                 style="height:260px;object-fit:cover" onerror="this.src='/img/none.png'" />
                        </a>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-1">@item.Title</h6>
                            <p class="card-text small text-muted mb-2">
                                @(item.Type ?? "movie") (@item.Year)
                            </p>
                            @if (isImportMode)
                            {
                                <form method="post" action="/jobs/import-from-search" class="mt-auto">
                                    <input type="hidden" name="filePath" value="@importFilePath" />
                                    <input type="hidden" name="title" value="@item.Title" />
                                    <input type="hidden" name="year" value="@item.Year" />
                                    <input type="hidden" name="videoType" value="@item.Type" />
                                    <div class="form-group small mb-2">
                                        <label class="text-muted">Disc Type:</label>
                                        <select name="discType" class="form-control form-control-sm">
                                            <option value="bluray" selected>Blu‑ray</option>
                                            <option value="dvd">DVD</option>
                                            <option value="uhd">4K UHD</option>
                                        </select>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm btn-block">Import &amp; Transcode</button>
                                </form>
                            }
                            else if (hasJob)
                            {
                                <form method="post" action="/jobs/assign-movie" class="mt-auto">
                                    <input type="hidden" name="jobId" value="@jobIdValue" />
                                    <input type="hidden" name="title" value="@item.Title" />
                                    <input type="hidden" name="year" value="@item.Year" />
                                    <input type="hidden" name="imdbId" value="@item.ImdbID" />
                                    <input type="hidden" name="posterUrl" value="@item.Poster" />
                                    <input type="hidden" name="videoType" value="@item.Type" />
                                    <button type="submit" class="btn btn-success btn-sm btn-block">Update Title</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small mt-auto">Select a job above</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Search results pages">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage > 1 ? PageUrl(currentPage - 1) : "#")">Previous</a>
                    </li>

                    @{
                        var startPage = Math.Max(1, currentPage - 4);
                        var endPage = Math.Min(totalPages, currentPage + 4);

                        if (startPage > 1)
                        {
                            <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                            if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                        }

                        for (var p = startPage; p <= endPage; p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link" href="@PageUrl(p)">@p</a>
                            </li>
                        }

                        if (endPage < totalPages)
                        {
                            if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            <li class="page-item"><a class="page-link" href="@PageUrl(totalPages)">@totalPages</a></li>
                        }
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" href="@(currentPage < totalPages ? PageUrl(currentPage + 1) : "#")">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
}
