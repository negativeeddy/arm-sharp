@model IEnumerable<ArmRipper.Core.Models.Job>
@if (!Model.Any())
{
    <tr><td colspan="7" class="text-center text-muted">No completed jobs.</td></tr>
}
else
{
    @foreach (var job in Model)
    {
        <tr>
            <td>@job.Id</td>
            <td>
                <a href="/jobs/jobdetail?jobId=@job.Id">@job.Title</a>
                @if (!string.IsNullOrEmpty(job.Warnings))
                {
                    <span class="badge bg-warning text-dark" title="@job.Warnings">Warning</span>
                }
            </td>
            <td>@job.DiscType</td>
            <td>
                @{
                    var badge = job.Status switch
                    {
                        JobState.Success => "bg-success",
                        JobState.Failure => "bg-danger",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badge">@job.Status</span>
            </td>
            <td>@job.StartTime.ToLocalTime().ToString("g")</td>
            <td>@(job.StopTime?.ToLocalTime().ToString("g"))</td>
            <td><a href="/jobs/jobdetail?jobId=@job.Id" class="btn btn-sm btn-outline-primary">View</a></td>
        </tr>
    }
}
